# Names only. Real values live in F:/.secrets/portfolio.env (loaded via PORTFOLIO_ENV_FILE). Never commit values.
PORTFOLIO_ENV_FILE=<unset>
GROQ_API_KEY=<unset>
LLM_SPEND_CAP_USD=25
LLM_SPEND_LEDGER=<unset>
P2_PROJECT_CAP_USD=3
# Optional: Claude adapter (dormant unless set). Verify model ids via GET /v1/models first.
ANTHROPIC_API_KEY=<unset>
ANTHROPIC_MODEL_BIG=<unset>
ANTHROPIC_MODEL_SMALL=<unset>
# Optional: Tavily search is auto-selected when set; otherwise DuckDuckGo (ddgs).
TAVILY_API_KEY=<unset>
# Optional: offline fixture corpus (tests / Project 6 red team)
SEARCH_FIXTURE_FILE=<unset>
LLM_PROVIDER=groq
REDIS_URL=redis://127.0.0.1:16379/0
# Comma-separated API keys accepted in the X-API-Key header (required; API fails closed without it)
RESEARCH_API_KEYS=<unset>
RATE_LIMIT_PER_MIN=10
# Budgets (graph-enforced)
BUDGET_MAX_SUB_QUESTIONS=4
BUDGET_MAX_SEARCHES_PER_SUBQ=2
BUDGET_MAX_TOTAL_TOKENS=40000
BUDGET_MAX_WALL_CLOCK_S=270
BUDGET_MAX_RUN_USD=0.10
